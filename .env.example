# Trigger.dev
# Get your secret key from https://cloud.trigger.dev (Project Settings → API Keys)
TRIGGER_SECRET_KEY=tr_dev_sk_xxx_replace_me

# Project ref (auto-populated by `npx trigger.dev init`)
TRIGGER_PROJECT_REF=proj_xxx_replace_me

# Local LLM provider (only needed from Phase 3)
LLM_PROVIDER=glm
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4-plus

# Local TTS provider (only needed from Phase 4)
TTS_PROVIDER=mock